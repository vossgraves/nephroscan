# NephroScan AI — Environment Configuration
# Copy to .env and fill in values for your deployment.

# Server
PORT=8080
FLASK_ENV=production
MODEL_DIR=models

# CORS — comma-separated origins allowed in production
# Example: https://nephroscan.onrender.com,https://nephroscan-ai.vercel.app
CORS_ORIGINS=*

# Frontend API base URL (relative path recommended for same-origin deployment)
# If frontend and backend are on the same origin, use /api
# If separate, use the full backend URL e.g. https://your-backend.onrender.com/api
API_BASE_URL=/api

# Maximum upload size in bytes (default 8MB)
MAX_UPLOAD_BYTES=8388608

# Inference timeout in seconds
INFERENCE_TIMEOUT=30

# ---------------------------------------------------------------------------
# Optional OpenAI intelligence layer (server-side only)
# ---------------------------------------------------------------------------
# Leave OPENAI_API_KEY unset/blank to keep /api/ai/* disabled: those routes
# then answer 503 {"status":"disabled"} and the frontend falls back to local
# model results and offline guidance. The key is never sent to the browser.
# OPENAI_API_KEY=sk-your-key-here

# Point at any OpenAI-compatible /chat/completions endpoint (e.g. a gateway)
OPENAI_BASE_URL=https://api.openai.com/v1

# Multimodal model for POST /api/ai/analyze-image
OPENAI_VISION_MODEL=gpt-5.6-luna

# Text model for POST /api/ai/chat
OPENAI_CHAT_MODEL=gpt-5.6-luna

# Outbound request timeout in seconds (clamped 5-120)
OPENAI_TIMEOUT=45

# Response length cap in tokens (clamped 128-4096)
OPENAI_MAX_OUTPUT_TOKENS=700

# Request bounds for the AI routes (independent of the local model routes)
AI_MAX_IMAGE_BYTES=4194304
AI_MAX_IMAGE_DIM=1024
AI_MAX_JSON_BYTES=65536
AI_MAX_MESSAGES=20
AI_MAX_MESSAGE_CHARS=4000
AI_MAX_TOTAL_CHARS=24000
AI_MAX_CONTEXT_CHARS=4000
