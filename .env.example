# NephroScan AI — Environment Configuration
# Copy to .env and fill in values for your deployment.

# Server
PORT=8080
FLASK_ENV=production
MODEL_DIR=models

# CORS — comma-separated origins allowed in production
# Example: https://nephroscan.onrender.com,https://nephroscan-ai.vercel.app
CORS_ORIGINS=*

# Frontend API base URL (relative path recommended for same-origin deployment)
# If frontend and backend are on the same origin, use /api
# If separate, use the full backend URL e.g. https://your-backend.onrender.com/api
API_BASE_URL=/api

# Maximum upload size in bytes (default 8MB)
MAX_UPLOAD_BYTES=8388608

# Inference timeout in seconds
INFERENCE_TIMEOUT=30

# ---------------------------------------------------------------------------
# Optional Gemini intelligence layer (server-side only)
# ---------------------------------------------------------------------------
# Leave AI_API_KEY unset/blank to keep /api/ai/* disabled. The key never
# reaches the browser. Get a Gemini key from https://aistudio.google.com/apikey
AI_PROVIDER=gemini
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_VISION_MODEL=gemini-3.5-flash-lite
AI_CHAT_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT=45
AI_MAX_OUTPUT_TOKENS=700

# Request bounds for the AI routes (independent of local model routes)
AI_MAX_IMAGE_BYTES=4194304
AI_MAX_IMAGE_DIM=1024
AI_MAX_JSON_BYTES=65536
AI_MAX_MESSAGES=20
AI_MAX_MESSAGE_CHARS=4000
AI_MAX_TOTAL_CHARS=24000
AI_MAX_CONTEXT_CHARS=4000

