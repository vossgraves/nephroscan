# NephroScan AI — Environment Configuration
# Copy to .env and fill in values for your deployment.
# Every key below is read by the Rust service in backend-rust/; nothing else is.

# Server
# Hosts that inject their own port (Render, Railway) override PORT automatically.
PORT=8080

# Directory holding kidney/chest/brain/heart .onnx graphs plus their .json
# manifests and models.json. Exported from the trained checkpoints out-of-band.
MODEL_DIR=models

# Directory served for same-origin static assets (index.html, dist/, demo_assets/).
FRONTEND_DIR=frontend

# ---------------------------------------------------------------------------
# Optional Gemini intelligence layer (server-side only)
# ---------------------------------------------------------------------------
# Leave AI_API_KEY unset/blank to keep /api/ai/* disabled: /api/ai/health then
# reports enabled=false and the frontend shows the "AI-based analysis is down"
# notice while local ONNX analysis keeps working. The key never reaches the
# browser. Get a Gemini key from https://aistudio.google.com/apikey
AI_PROVIDER=gemini
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_VISION_MODEL=gemini-3.5-flash-lite
AI_CHAT_MODEL=gemini-3.5-flash-lite

# Upstream request timeout in seconds (clamped to 5-120).
AI_TIMEOUT=45
