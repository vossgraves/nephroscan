# Git and local environments
.git
.git/**
.env
.env.*
!.env.example
node_modules
**/node_modules

# Local-only documents and scripts
*.docx
*.ps1

# Never ship raw checkpoints; the image only needs the exported ONNX graphs
models/*.pth
models/*.pt
models/*.safetensors

# Generated frontend output is rebuilt in the Docker build stage
frontend/dist
frontend/dist/**

# Rust build artifacts are produced inside the build stage
backend-rust/target
backend-rust/target/**
